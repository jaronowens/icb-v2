{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "build",
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "app.ts",
    "bin/**/*",
    "entity/**/*",
    "repository/**/*",
    "service/**/*",
    "routes/**/*",
    "util/**/*"
  ]
}
